# Copy to flowmat_backend/.env for docker compose. Replace both password values
# with the same local-only secret; never commit .env.
POSTGRES_DB=flowmat
POSTGRES_USER=flowmat_dev
POSTGRES_PASSWORD=replace-with-a-local-password

# Export these variables into the shell before running Gradle. Compose reads
# .env itself, while bootRun does not.
DB_URL=jdbc:postgresql://localhost:5432/flowmat
DB_USERNAME=flowmat_dev
DB_PASSWORD=replace-with-a-local-password
REDIS_HOST=localhost
REDIS_PORT=6379
# Use a random local secret of at least 32 characters.
JWT_SECRET=replace-with-a-local-secret-at-least-32-characters
